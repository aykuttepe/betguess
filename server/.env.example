FOOTBALL_API_URL=http://localhost:8000


# Required: generate a random secret, e.g. openssl rand -hex 32
JWT_SECRET=
# Comma-separated exact browser origins; include dev origin only when needed
CORS_ORIGINS=https://betguess.mytepeapi.com.tr
# Explicit proxy IPs/CIDRs only. Empty disables forwarding-header trust.
# After confirming a local Cloudflare Tunnel: TRUST_PROXY=127.0.0.1,::1
TRUST_PROXY=
